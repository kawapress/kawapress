{
  "name": "@kawapress/plugin-algolia-search",
  "type": "module",
  "version": "0.8.1",
  "description": "Algolia DocSearch for KawaPress sites",
  "license": "MIT",
  "homepage": "https://kawapress.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawapress/kawapress.git",
    "directory": "packages/plugin-algolia-search"
  },
  "bugs": {
    "url": "https://github.com/kawapress/kawapress/issues"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime-plugin": {
      "types": "./src/runtime-plugin.ts",
      "import": "./src/runtime-plugin.ts",
      "default": "./src/runtime-plugin.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README-zh-CN.md",
    "src/**/!(*.test.*)"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "kawapress": "workspace:^",
    "vue": "catalog:frontend"
  },
  "dependencies": {
    "@docsearch/css": "catalog:frontend",
    "@docsearch/js": "catalog:frontend",
    "@unhead/vue": "catalog:frontend"
  },
  "devDependencies": {
    "happy-dom": "catalog:dev",
    "kawapress": "workspace:*",
    "vite": "catalog:node",
    "vue": "catalog:frontend"
  }
}
