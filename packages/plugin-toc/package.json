    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "kawapress": "workspace:>=0.8.3 <0.10.0"
  },
  "dependencies": {
    "markdown-exit": "catalog:markdown"
  },
  "devDependencies": {
    "@mdit/plugin-attrs": "catalog:markdown",
    "markdown-it-anchor": "catalog:markdown"
  }
