{
  "name": "@kawapress/plugin-toc",
  "type": "module",
  "version": "0.8.3",
  "description": "[[toc]] table of contents for KawaPress pages",
  "license": "MIT",
  "homepage": "https://kawapress.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawapress/kawapress.git",
    "directory": "packages/plugin-toc"
  },
  "bugs": {
    "url": "https://github.com/kawapress/kawapress/issues"
  },
  "keywords": [
    "kawapress",
    "kawapress-plugin"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
