  "description": "Web analytics for KawaPress: Google Analytics, Plausible, Umami and Cloudflare Web Analytics, with in-site navigation counted",
  "license": "MIT",
  "homepage": "https://kawapress.dev/",
  "repository": {
    "type": "git",
