{
  "name": "@kawapress/plugin-vue-component-meta",
  "type": "module",
  "version": "0.1.1",
  "description": "API tables for Vue components in KawaPress Markdown, read from the source with vue-component-meta",
  "license": "MIT",
  "homepage": "https://kawapress.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawapress/kawapress.git",
    "directory": "packages/plugin-vue-component-meta"
  },
  "bugs": {
    "url": "https://github.com/kawapress/kawapress/issues"
  },
  "keywords": [
    "kawapress",
    "kawapress-plugin"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./runtime-plugin": {
      "types": "./src/runtime-plugin.ts",
      "import": "./src/runtime-plugin.ts",
      "default": "./src/runtime-plugin.ts"
    },
    "./api": {
      "import": "./src/ComponentApi.vue",
      "default": "./src/ComponentApi.vue"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README-zh-CN.md",
    "src/**/!(*.test.*)"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "kawapress": "workspace:>=0.8.3 <0.10.0",
    "markdown-exit": "catalog:markdown",
    "typescript": "^6.0.0",
    "vite": "catalog:node",
    "vue": "catalog:frontend"
  },
  "dependencies": {
    "vue-component-meta": "catalog:node"
  },
  "devDependencies": {
    "happy-dom": "catalog:dev",
    "kawapress": "workspace:*",
    "markdown-exit": "catalog:markdown",
    "typescript": "catalog:dev",
    "vite": "catalog:node",
    "vue": "catalog:frontend"
  }
}
